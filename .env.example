# =============================================================================
# AI CTF Attack-Defend Game — API Keys
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Each provider requires its own API key to function.
# NOT NEEDED for --local-only mode (all models run via Ollama).
# =============================================================================

# OpenAI (ChatGPT) — https://platform.openai.com/api-keys
# NOT NEEDED if using --local mode (Qwen 3.5 via Ollama replaces ChatGPT)
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# NOT NEEDED if using --local mode (Gemma via Ollama replaces Gemini)
GEMINI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# xAI (Grok) — https://console.x.ai/
XAI_API_KEY=

# Perplexity — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# =============================================================================
# Game Timing
# =============================================================================

# Defense phase duration in minutes (default: 10)
# Only defenders are active. Attackers wait.
# DEFENSE_MINUTES=10

# Battle phase duration in minutes (default: 60)
# Both attackers and defenders run simultaneously.
# BATTLE_MINUTES=60

# Command execution timeout in seconds (default: 120)
# COMMAND_TIMEOUT_SECONDS=120

# Log directory (default: ./logs)
# LOG_DIR=./logs

# =============================================================================
# Ollama Cloud API (--cloud mode)
# =============================================================================

# API key from https://ollama.com/settings/keys
# Required for --cloud mode. Not needed for local Ollama.
# OLLAMA_API_KEY=

# Override cloud model names:
# CLOUD_GEMMA_MODEL=gemma4              # default — Google Gemma 4
# CLOUD_GPT_MODEL=gpt-oss:120b-cloud   # default — OpenAI GPT-OSS 120B
# CLOUD_GEMINI_MODEL=gemini-3-flash-preview:cloud  # default — Google Gemini 3 Flash

# =============================================================================
# Local Models via Ollama
# =============================================================================

# Set to "true" to use Ollama for Qwen and Gemma instead of cloud APIs.
# USE_LOCAL_MODELS=true

# Ollama server URL (default: http://localhost:11434)
# A single Ollama instance serves all models, swapping on/off GPU as needed.
# OLLAMA_BASE_URL=http://localhost:11434

# Override local model names:
# OLLAMA_GPT_MODEL=qwen3.5:2b            # default
# OLLAMA_GEMMA_MODEL=gemma3:1b           # default
# OLLAMA_CLAUDE_MODEL=smollm2:1.7b       # default
# OLLAMA_GROK_MODEL=granite3.1-dense:2b  # default
# OLLAMA_PERPLEXITY_MODEL=llama3.2:1b    # default

# For machines with a GPU, use larger models:
# OLLAMA_GPT_MODEL=qwen3.5:4b
# OLLAMA_GEMMA_MODEL=gemma4:e2b
# OLLAMA_CLAUDE_MODEL=mistral
