# =============================================================================
# AI CTF Attack-Defend Game — API Keys
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Each provider requires its own API key to function.
# See set-up.txt for instructions on obtaining keys.
# =============================================================================

# OpenAI (ChatGPT) — https://platform.openai.com/api-keys
# NOT NEEDED if using --local mode (Qwen 3.5 via Ollama replaces ChatGPT)
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# NOT NEEDED if using --local mode (Gemma 4 via Ollama replaces Gemini)
GEMINI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# xAI (Grok) — https://console.x.ai/
XAI_API_KEY=

# Perplexity — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# =============================================================================
# Game Configuration (optional overrides)
# =============================================================================

# Number of rounds per game (default: 50)
# GAME_ROUNDS=50

# Seconds between each agent turn (default: 5)
# TURN_DELAY_SECONDS=5

# Command execution timeout in seconds (default: 30)
# COMMAND_TIMEOUT_SECONDS=30

# Log directory (default: ./logs)
# LOG_DIR=./logs

# =============================================================================
# Local Models via Ollama (optional — use --local flag or set USE_LOCAL_MODELS)
# =============================================================================

# Set to "true" to use Ollama for Qwen and Gemma instead of cloud APIs.
# This eliminates the need for OPENAI_API_KEY and GEMINI_API_KEY.
# Requires Ollama running (docker compose up ollama).
# USE_LOCAL_MODELS=true

# Ollama server URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Override local model names.
# Defaults are small models that run on CPU without a GPU:
# OLLAMA_GPT_MODEL=qwen3.5:2b        # ~2.7GB — default, fast on CPU
# OLLAMA_GEMMA_MODEL=gemma4:e2b      # ~5GB — default, fast on CPU

# For machines with a GPU (16GB+ VRAM), use the full-size models:
# OLLAMA_GPT_MODEL=qwen3.5:4b        # 3.4GB — larger variant
# OLLAMA_GEMMA_MODEL=gemma4:26b      # 18GB — needs GPU or 32GB+ RAM
